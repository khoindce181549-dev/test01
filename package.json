{
  "name": "quizably",
  "version": "1.2.3",
  "private": true,
  "homepage": "https://github.com/bhumiavaiya/quizably",
  "repository": {
    "type": "git",
    "url": "https://github.com/bhumiavaiya/quizably.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint \"src/**/*.{js,vue}\"",
    "lint:fix": "eslint \"src/**/*.{js,vue}\" --fix",
    "format": "prettier --write \"src/**/*.{js,vue,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "i18n:pot": "node scripts/generate-pot.mjs",
    "package": "node scripts/build-release.mjs",
    "release": "npm run build && npm run package"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@tiptap/extension-color": "^3.23.6",
    "@tiptap/extension-link": "^3.23.6",
    "@tiptap/extension-placeholder": "^3.23.6",
    "@tiptap/extension-text-align": "^3.23.6",
    "@tiptap/extension-text-style": "^3.23.6",
    "@tiptap/extension-underline": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "@tiptap/vue-3": "^3.23.6",
    "lucide-vue-next": "^0.300.0",
    "mitt": "^3.0.1",
    "pinia": "^2.1.0",
    "terser": "^5.48.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@vitejs/plugin-legacy": "^5.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vue/test-utils": "^2.4.0",
    "@wordpress/api-fetch": "^7.44.0",
    "@wordpress/block-editor": "^15.17.0",
    "@wordpress/blocks": "^15.17.0",
    "@wordpress/components": "^32.6.0",
    "@wordpress/element": "^6.44.0",
    "@wordpress/i18n": "^6.17.0",
    "archiver": "^8.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.19.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.1.0",
    "vite": "^5.0.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "eslintConfig": {
    "root": true,
    "env": { "browser": true, "es2022": true, "node": true },
    "extends": ["eslint:recommended", "plugin:vue/vue3-recommended"],
    "parserOptions": { "ecmaVersion": "latest", "sourceType": "module" },
    "rules": {
      "vue/multi-word-component-names": "off",
      "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
      "no-console": ["warn", { "allow": ["warn", "error"] }]
    },
    "overrides": [
      {
        "files": ["src/frontend/screens/Result.vue"],
        "rules": { "vue/no-v-html": "off" }
      }
    ]
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5",
    "printWidth": 100,
    "tabWidth": 2,
    "arrowParens": "always"
  }
}
